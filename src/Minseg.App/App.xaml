<Application x:Class="Minseg.App.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Minseg.App">
 <Application.Resources>
 <ResourceDictionary>
 <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Icons.xaml"/></ResourceDictionary.MergedDictionaries>
  <FontFamily x:Key="BodyFont">pack://application:,,,/MINSEG-Control;component/Assets/#Source Sans 3</FontFamily>
  <FontFamily x:Key="TitleFont">pack://application:,,,/MINSEG-Control;component/Assets/#Barlow</FontFamily>
  <SolidColorBrush x:Key="Canvas" Color="#101720"/>
  <SolidColorBrush x:Key="Ink" Color="#F4F7FB"/>
  <SolidColorBrush x:Key="Subtle" Color="#C4D2E2"/>
  <SolidColorBrush x:Key="Surface" Color="#1C2938"/>
  <SolidColorBrush x:Key="Raised" Color="#263649"/>
  <SolidColorBrush x:Key="Input" Color="#162231"/>
  <SolidColorBrush x:Key="Edge" Color="#455466"/>
  <SolidColorBrush x:Key="StrongEdge" Color="#596C83"/>
  <SolidColorBrush x:Key="Hover" Color="#344458"/>
  <SolidColorBrush x:Key="Track" Color="#111B27"/>
  <SolidColorBrush x:Key="Thumb" Color="#566D84"/>
  <SolidColorBrush x:Key="PolicyPanel" Color="#302B40"/>
  <SolidColorBrush x:Key="Wps" Color="#22D3F5"/>
  <SolidColorBrush x:Key="AnyDesk" Color="#FF923F"/>
  <SolidColorBrush x:Key="Blocking" Color="#BF9BFF"/>
  <SolidColorBrush x:Key="Office" Color="#42E2AD"/>
  <SolidColorBrush x:Key="WpsFill" Color="#22D3F5"/>
  <SolidColorBrush x:Key="AnyDeskFill" Color="#FF923F"/>
  <SolidColorBrush x:Key="BlockingFill" Color="#BF9BFF"/>
  <SolidColorBrush x:Key="OfficeFill" Color="#42E2AD"/>
  <SolidColorBrush x:Key="Header" Color="#A31E2A"/>
  <Style x:Key="AppWindow" TargetType="Window"><Setter Property="FontFamily" Value="{StaticResource BodyFont}"/><Setter Property="FontSize" Value="15"/><Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="Background" Value="{DynamicResource Canvas}"/></Style>
  <Style TargetType="Window" BasedOn="{StaticResource AppWindow}"/>
  <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
  <Style TargetType="Button">
   <Setter Property="Padding" Value="16,9"/><Setter Property="Margin" Value="0,0,10,0"/><Setter Property="Background" Value="{DynamicResource Surface}"/><Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="BorderBrush" Value="{DynamicResource StrongEdge}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="MinHeight" Value="39"/><Setter Property="FontFamily" Value="{StaticResource BodyFont}"/><Setter Property="FontSize" Value="14"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6"><StackPanel Orientation="Horizontal" Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center">
 <Path x:Name="ActionGlyph" Data="{Binding RelativeSource={RelativeSource TemplatedParent},Path=(local:ActionIcon.Data)}" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="17" Height="17" Stretch="Uniform" Margin="0,0,9,0" VerticalAlignment="Center"/>
 <ContentPresenter RecognizesAccessKey="True" TextElement.Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center"/>
 </StackPanel></Border><ControlTemplate.Triggers><Trigger Property="local:ActionIcon.Data" Value="{x:Null}"><Setter TargetName="ActionGlyph" Property="Visibility" Value="Collapsed"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.85"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource Wps}"/><Setter TargetName="Surface" Property="BorderThickness" Value="2"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.90"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="{DynamicResource WpsFill}"/><Setter Property="Foreground" Value="#10202A"/><Setter Property="BorderThickness" Value="0"/></Style>
  <Style x:Key="Title" TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="FontFamily" Value="{StaticResource TitleFont}"/><Setter Property="FontSize" Value="25"/><Setter Property="Margin" Value="0,0,0,8"/></Style>
  <Style x:Key="Section" TargetType="TextBlock" BasedOn="{StaticResource Title}"><Setter Property="FontSize" Value="20"/></Style>
  <Style x:Key="Hint" TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource Subtle}"/><Setter Property="Margin" Value="0,0,0,14"/></Style>
  <Style x:Key="Panel" TargetType="Border"><Setter Property="Background" Value="{DynamicResource Surface}"/><Setter Property="BorderBrush" Value="{DynamicResource Edge}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="8"/><Setter Property="Padding" Value="20"/><Setter Property="Margin" Value="0,0,0,16"/></Style>
  <Style TargetType="CheckBox"><Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="Margin" Value="0,6,0,6"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
  <Style TargetType="TextBox"><Setter Property="Background" Value="{DynamicResource Input}"/><Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="CaretBrush" Value="{DynamicResource Ink}"/><Setter Property="Padding" Value="9,7"/><Setter Property="BorderBrush" Value="{DynamicResource StrongEdge}"/><Setter Property="FontSize" Value="15"/></Style>
  <Style TargetType="TabControl"><Setter Property="BorderThickness" Value="0"/><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{DynamicResource Ink}"/></Style>
  <Style TargetType="TabItem"><Setter Property="Foreground" Value="{DynamicResource Ink}"/>
   <Setter Property="Padding" Value="18,9"/><Setter Property="Margin" Value="0,0,8,8"/><Setter Property="FontSize" Value="15"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem">
    <Border x:Name="TabSurface" Background="Transparent" BorderBrush="Transparent" BorderThickness="0,0,0,3" Padding="{TemplateBinding Padding}"><StackPanel Orientation="Horizontal"><Path Data="{Binding RelativeSource={RelativeSource TemplatedParent},Path=(local:ActionIcon.Data)}" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.8" StrokeLineJoin="Round" Width="17" Height="17" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/><ContentPresenter ContentSource="Header" TextElement.Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center"/></StackPanel></Border>
    <ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="TabSurface" Property="Background" Value="{DynamicResource Surface}"/><Setter TargetName="TabSurface" Property="BorderBrush" Value="{DynamicResource Wps}"/><Setter Property="FontWeight" Value="SemiBold"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="TabSurface" Property="Background" Value="{DynamicResource Hover}"/></Trigger></ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="DataGrid"><Setter Property="Background" Value="{DynamicResource Input}"/><Setter Property="RowBackground" Value="{DynamicResource Surface}"/><Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="CanUserAddRows" Value="False"/><Setter Property="CanUserDeleteRows" Value="False"/><Setter Property="HeadersVisibility" Value="Column"/><Setter Property="GridLinesVisibility" Value="Horizontal"/><Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource Edge}"/><Setter Property="BorderBrush" Value="{DynamicResource Edge}"/><Setter Property="RowHeight" Value="35"/><Setter Property="FontSize" Value="13"/><Setter Property="AlternatingRowBackground" Value="{DynamicResource Raised}"/></Style>
  <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="{DynamicResource Hover}"/><Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="Padding" Value="10,9"/><Setter Property="BorderBrush" Value="{DynamicResource StrongEdge}"/><Setter Property="BorderThickness" Value="0,0,1,1"/></Style>
  <Style TargetType="ScrollBar">
   <Setter Property="Background" Value="{DynamicResource Track}"/><Setter Property="Width" Value="12"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar"><Border Background="{TemplateBinding Background}" CornerRadius="6"><Track x:Name="PART_Track" Orientation="{TemplateBinding Orientation}" IsDirectionReversed="True">
    <Track.DecreaseRepeatButton><RepeatButton x:Name="DecreasePage" Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/></Track.DecreaseRepeatButton>
    <Track.Thumb><Thumb MinHeight="24"><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="{DynamicResource Thumb}" CornerRadius="5" Margin="2"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
    <Track.IncreaseRepeatButton><RepeatButton x:Name="IncreasePage" Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/></Track.IncreaseRepeatButton>
   </Track></Border><ControlTemplate.Triggers><Trigger Property="Orientation" Value="Horizontal"><Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/><Setter TargetName="DecreasePage" Property="Command" Value="ScrollBar.PageLeftCommand"/><Setter TargetName="IncreasePage" Property="Command" Value="ScrollBar.PageRightCommand"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
   <Style.Triggers><Trigger Property="Orientation" Value="Horizontal"><Setter Property="Width" Value="Auto"/><Setter Property="Height" Value="12"/></Trigger></Style.Triggers>
  </Style>
  <Style TargetType="Expander"><Setter Property="Foreground" Value="{DynamicResource Ink}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Expander"><StackPanel>
    <ToggleButton Content="{TemplateBinding Header}" Foreground="{TemplateBinding Foreground}" IsChecked="{Binding IsExpanded,RelativeSource={RelativeSource TemplatedParent},Mode=TwoWay}" HorizontalContentAlignment="Left">
     <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><StackPanel Orientation="Horizontal" Background="Transparent">
      <Path x:Name="Chevron" Data="M2,4 L7,9 L12,4" Stroke="{TemplateBinding Foreground}" StrokeThickness="2" Width="14" Height="14" Margin="0,0,8,0" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5"/>
      <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center"/>
     </StackPanel><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Chevron" Property="RenderTransform"><Setter.Value><RotateTransform Angle="180"/></Setter.Value></Setter></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chevron" Property="Stroke" Value="{DynamicResource Wps}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></ToggleButton.Template>
    </ToggleButton>
    <ContentPresenter x:Name="ExpandedContent" ContentSource="Content" Visibility="Collapsed"/>
   </StackPanel><ControlTemplate.Triggers><Trigger Property="IsExpanded" Value="True"><Setter TargetName="ExpandedContent" Property="Visibility" Value="Visible"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
 </ResourceDictionary>
 </Application.Resources>
</Application>

